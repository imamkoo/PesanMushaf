# Konfigurasi Apache/LiteSpeed untuk SPA JEJAKA500 di cPanel.
# Disalin menjadi dist/.htaccess oleh .github/workflows/release.yml.
# Padanan dari frontend/vercel.json (rewrites + headers).

Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Berkas/folder yang benar-benar ada dilayani apa adanya.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Request aset (punya ekstensi) yang hilang jangan diubah jadi HTML.
    RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{1,8}$
    RewriteRule ^ - [L,R=404]

    # Sisanya adalah route SPA.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # index.html dan service worker tidak boleh di-cache.
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Aset Vite ber-hash: aman di-cache permanen.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/.+\.[a-f0-9]{8,}\.(js|css|woff2|png|svg|webp)$" IMMUTABLE_ASSET
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>
