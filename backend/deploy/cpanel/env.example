# Template .env untuk backend Laravel di cPanel (CloudHost/LiteSpeed + MySQL).
# Salin menjadi backend/.env lalu isi nilai sebenarnya. JANGAN commit file .env.

APP_NAME="JEJAKA500"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.jejaka500.id

# Hosting langsung (tanpa Cloudflare di depan) -> header CF-Connecting-IP
# tidak boleh dipercaya, kalau tidak rate limit bisa dilewati dengan spoofing.
# Set true HANYA bila seluruh trafik masuk lewat Cloudflare.
TRUST_CF_CONNECTING_IP=false

CORS_ALLOWED_ORIGINS=https://jejaka500.id,https://www.jejaka500.id
CORS_ALLOWED_ORIGINS_PATTERNS=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL dari cPanel (bukan PostgreSQL).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_jejaka500
DB_USERNAME=cpaneluser_jejaka
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@jejaka500.id"
MAIL_FROM_NAME="${APP_NAME}"

# Akun admin Filament (dipakai seeder; isi sebelum `php artisan db:seed`).
ADMIN_NAME="Admin Jakarta"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Direktori sekolah (seeder SchoolSuggestion)
SCHOOL_DIRECTORY_API_URL=https://api-sekolah-indonesia.vercel.app
SCHOOL_DIRECTORY_PROVINSI_KODE=010000

# Midtrans Snap (sandbox: is_production=false)
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SSL_VERIFY=true

# Green API WhatsApp — nama variabel wajib persis seperti ini.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_REGISTRATION_SUCCESS_ENABLED=true
WHATSAPP_PAYMENT_SUCCESS_ENABLED=true
WHATSAPP_TEST_TO=
GREEN_API_URL=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_TIMEOUT=20
GREEN_API_SSL_VERIFY=true
