        {
          "name": "Get Batches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/batches?district_id={{district_id}}&education_level={{education_level}}&only_available=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "batches"
              ],
              "query": [
                {
                  "key": "district_id",
                  "value": "{{district_id}}"
                },
                {
                  "key": "education_level",
                  "value": "{{education_level}}"
                },
                {
                  "key": "only_available",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
