      "item": [
        {
          "name": "Get Districts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/districts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "districts"
              ]
            }
          },
          "response": []
        },
