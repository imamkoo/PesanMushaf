    {
      "name": "Registration",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"district_id\": {{district_id}},\n  \"education_level\": \"{{education_level}}\",\n  \"edition\": \"{{edition}}\",\n  \"name\": \"{{registrant_name}}\",\n  \"phone_number\": \"{{phone_number}}\",\n  \"school_name\": \"{{school_name}}\",\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData?.data?.registration_code) {",
                  "  pm.collectionVariables.set('registration_code', jsonData.data.registration_code);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Check Registration Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/registrations/{{registration_code}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "registrations",
                "{{registration_code}}",
                "status"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_key",
      "value": "test-api-key"
    },
    {
      "key": "district_id",
      "value": "1"
    },
